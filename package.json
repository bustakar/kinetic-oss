{
  "name": "kinetic-oss",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "convex dev --start 'vite dev --port 3000'",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:publish": "tsx scripts/publish-catalog.ts",
    "check": "pnpm generate-routes && prettier --check . && eslint . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "@workos/authkit-tanstack-react-start": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.31",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.56",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.8.1",
    "shadcn": "^4.18.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
