{
  "name": "@kinetic/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm generate-routes && tsc --noEmit && pnpm test && pnpm build && pnpm check:server-output",
    "check:server-output": "find .output/server -type f -name '*.mjs' -exec node --check {} \\;",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "test": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@kinetic/convex": "workspace:*",
    "@kinetic/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.30",
    "@tanstack/react-start": "^1.168.47",
    "@workos/authkit-tanstack-react-start": "^0.11.0",
    "convex": "^1.44.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.167.31",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "8.2.1"
  }
}
